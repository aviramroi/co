# Wingman environment

# Enables the Claude brain. Without it, a heuristic fallback drafts messages.
ANTHROPIC_API_KEY=

# Model + control-panel port (optional overrides)
WINGMAN_MODEL=claude-opus-4-8
WINGMAN_PORT=4600
WINGMAN_HOST=127.0.0.1

# Where state + saved browser sessions live
WINGMAN_STATE_DIR=.wingman

# --- Auth & security ---
# JWT signing secret. REQUIRED in production (NODE_ENV=production). Generate with:
#   openssl rand -hex 32
WINGMAN_AUTH_SECRET=
# Exact origin of the web app, for CORS on direct API access (BFF doesn't need it).
WINGMAN_WEB_ORIGIN=http://localhost:3000
# Allow more than the first (bootstrap) operator account to be created. Default off.
WINGMAN_ALLOW_SIGNUP=0
# Token lifetime in seconds (default 7 days).
# WINGMAN_AUTH_TTL=604800
# Bootstrap an account non-interactively for `wingman useradd`:
# WINGMAN_ADMIN_EMAIL=
# WINGMAN_ADMIN_PASSWORD=

# Per-channel mode overrides: mock | live | off
WINGMAN_TINDER_MODE=mock
WINGMAN_MARKETPLACE_MODE=mock
WINGMAN_GROUPS_MODE=mock

# Set to 1 to run live browsers headful (useful while tuning selectors)
# WINGMAN_HEADFUL=1
